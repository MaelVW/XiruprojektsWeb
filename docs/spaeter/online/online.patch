+/* ── Online (assets/js/online.js, nur wenn eingeschaltet) ─────────────── */
+.online-pill { position: fixed; left: 1rem; bottom: 1rem; z-index: 60; display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .75rem; border-radius: 99px;
+    border: 1px solid var(--border-strong); background: color-mix(in srgb, var(--surface) 92%, transparent); color: var(--text); font: 600 .8rem var(--font); cursor: pointer; box-shadow: var(--shadow); backdrop-filter: blur(6px); }
