+.online-row--all { background: transparent; border: 1px dashed var(--border); }
+.online-greet { max-width: 9.5rem; font-size: .78rem; padding: .25rem .4rem; }
+.online-board__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; font-size: .86rem; }
+.online-board__list li { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: .4rem; }
+.online-board__list li.is-me b { color: var(--accent); }
+.online-board__list li span:last-child { font-variant-numeric: tabular-nums; color: var(--text-muted); }
+@media print { .online-pill, .online-panel { display: none; } }
